{
  "name": "ServerSolution",
  "version": "4.0.3",
  "main": "electron/main.js",
  "scripts": {
    "app": "electron --trace-warnings --trace-deprecation  --disable-gpu --enable-logging .  ",
    "app:watch": "npx electronmon  . ",
    "dev": "nodemon --exec npm run app",
    "packageLink": "del /f packageCopy.json && mklink /H packageCopy.json package.json",
    "clearENV": "node ./removeEnvUnused.js",
    "backend": "nodemon ./BackendAPI/server.js",
    "build": "electron-builder --publish never",
    "deploy": "electron builder --publish always",
    "start": "node Common/copySetup.js && node app.js"
  },
  "author": "HasabymGroup #developers",
  "license": "ISC",
  "dependencies": {
    "@stdlib/string-format": "^0.2.1",
    "asar": "^3.2.0",
    "axios": "^1.1.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.2",
    "dotenv-expand": "^11.0.6",
    "ejs": "^3.1.9",
    "electron-log": "^5.1.2",
    "express": "^4.18.1",
    "fs-jetpack": "^5.1.0",
    "joi": "^17.6.0",
    "json-stable-stringify": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "lossless-json": "^4.0.1",
    "moment": "^2.30.1",
    "mssql": "^9.3.2",
    "multer": "^1.4.5-lts.1",
    "ping": "^0.4.2",
    "sharp": "^0.33.3",
    "sweetalert2": "^11.26.22"
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.0"
  },
  "description": "Synchronize data for Server Solution",
  "build": {
    "appId": "com.serversolution.app",
    "asarUnpack": [
      "Queries/**/*"
    ],
    "productName": "Server Solution",
    "copyright": "Copyright © Hasabym Developers",
    "extraResources": [
      ".env",
      "packageCopy.json",
      {
        "from": "Queries/",
        "to": "app/Queries"
      }
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Server Solution",
      "installerIcon": "electron/assets/icons/hs_ss_logo_white.ico"
    },
    "directories": {
      "buildResources": ".",
      "output": "./Server Solution Setup"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icons/hs_ss_logo_white.ico"
    }
  }
}
