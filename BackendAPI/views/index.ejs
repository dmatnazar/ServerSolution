<body>
    <div class="main_div">
        <% if(data) { %>
            <% for(let i=0; i < data.length; i++) { %>
                   
                <% switch(type) {
                    case 'version' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;

                    case 'get_index' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;
                    

                    case 'get_dashboard' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;

                    case 'get_existence_check' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;

                    case 'get_report' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;

                    case 'get_materials' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;

                    case 'get_generals' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;

                    case 'get_warehouses' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;

                    case 'post_index' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;

                    case 'post_procedure' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;

                    case 'post_transaction' : %>
                    <a class="link" href="<%= url %>/<%= data[i] %>">
                        <%= data[i] %>
                    </a>
                    <% break;
                    }
                    %>
            <% } %>
        <% } %>
    </div>
